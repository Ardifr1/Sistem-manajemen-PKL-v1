APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# URL aplikasi frontend (SPA) — dipakai untuk tautan aktivasi akun.
FRONTEND_URL=http://localhost:5173
ACCOUNT_ACTIVATION_PATH=/aktivasi
ACCOUNT_ACTIVATION_EXPIRES_HOURS=72

# Masa berlaku permintaan reset password (jam). Permintaan yang lebih tua
dianggap kedaluwarsa dan harus diajukan ulang.
PASSWORD_RESET_EXPIRES_HOURS=72

# Origin tambahan yang diizinkan mengakses API (pisahkan koma, tanpa wildcard).
# Contoh: CORS_ALLOWED_ORIGINS=https://simagang.sekolah.sch.id
CORS_ALLOWED_ORIGINS=

# Akun demo hanya dibuat bila nilai ini true ATAU APP_ENV bukan production.
SEED_DEMO_ACCOUNTS=false

# AI Journal Assistant (OpenAI-compatible). API key HANYA di server.
# Default penyedia: Z.ai (GLM). Kosongkan AI_API_KEY untuk menonaktifkan fitur.
AI_API_KEY=
AI_BASE_URL=https://api.z.ai/api/paas/v4
AI_MODEL=glm-5.3
AI_TIMEOUT_SECONDS=20
AI_MAX_DRAFT_CHARS=1500
AI_RATE_LIMIT_PER_MINUTE=8

# Gateway WhatsApp (Fonnte). JANGAN hardcode di kode.
# Dapatkan token di https://fonnte.com — biarkan kosong untuk menonaktifkan.
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
